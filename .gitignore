# Secrets / credentials — never commit
.Renviron
.Rprofile
*.env
.env

# R session cruft
.Rhistory
.RData
.Rproj.user/

# Regenerable fitted-model blob (rebuild via scripts/model_wait_days.R)
model_output/models.rds

# Interactive leaflet maps (regenerable; render to PNG locally with webshot2)
model_output/supp/*_physician_locations.html
model_output/supp/*_physician_locations_files/

# Isochrone data blobs (regenerable via scripts/valhalla_ent_isochrones.R; large)
model_output/isochrones/*.gpkg
model_output/isochrones/*.rds
model_output/isochrones/batch.log
model_output/isochrones/resume.log

# Rendered manuscript previews (regenerable; keep .docx, drop bulky html)
manuscript_output/*.html
manuscript_output/*_files/

# Uncompressed TIFF companions (keep PNG)
model_output/*.tiff

# Published artifact source (regenerable; large base64)
manuscript/artifact*.html

# Comparator/reference PDFs reviewed locally (not part of the repo)
/1-s2.0-S0010782425001040-main.pdf
/1-s2.0-S0010782425001362-main.pdf
/pharmacy-14-00081.pdf

# Reference PDFs reviewed locally (not part of the repo)
/pdf_review/

